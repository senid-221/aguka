# AI Studio runtime injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
APP_URL="MY_APP_URL"

# Server Port & Environment
NODE_ENV="production"
PORT="3000"

# WhatsApp Business Cloud API Configuration
# Get from Meta for Developers (developers.facebook.com) > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID="109876543210987"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxx_replace_with_meta_system_user_token"
WHATSAPP_VERIFY_TOKEN="replace_with_a_random_verify_token_you_choose"
WHATSAPP_APP_SECRET="replace_with_meta_app_secret_for_sha256_signature_verification"

# Database Configuration (PostgreSQL with connection pooling)
DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/aguka_db?schema=public"

# Redis & Queue Configuration (BullMQ)
REDIS_URL="redis://:strong_redis_password@localhost:6379"

# S3 / Object Storage (Cloudflare R2, AWS S3, or MinIO)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="aguka-user-media"
S3_ACCESS_KEY_ID="replace_with_s3_key"
S3_SECRET_ACCESS_KEY="replace_with_s3_secret"

# Admin Authentication & Encryption Secret
# ADMIN_JWT_SECRET has no built-in fallback: admin login is disabled until you set it.
ADMIN_JWT_SECRET="replace_with_random_secret_min_32_chars"
ADMIN_DEFAULT_EMAIL="replace_with_admin_email"
ADMIN_DEFAULT_PASSWORD="replace_with_strong_admin_password"

# Platform Rate Limits & Budgets
MAX_MESSAGES_PER_MINUTE_PER_USER="20"
MAX_DAILY_AI_TOKENS_PER_USER="50000"
