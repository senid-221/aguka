// Aguka AI - Production Prisma Schema for PostgreSQL
// Multi-tenant, bilingual Kinyarwanda/English WhatsApp AI platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LanguagePreference {
  KINYARWANDA
  ENGLISH
  BOTH
}

enum UserRole {
  CANDIDATE
  WORKER
  EMPLOYER
  STUDENT
  DEVELOPER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageContentType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  INTERACTIVE_REPLY
  LOCATION
}

enum AgentType {
  ROUTER
  JOB_FINDER
  CAREER_ASSISTANT
  IMAGE_STUDIO
  CODING_AGENT
  STUDY_TUTOR
  EMPLOYMENT_MARKETPLACE
  ROAD_SAFETY_ACADEMY
}

enum TaskStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
  HYBRID
}

enum VerificationStatus {
  VERIFIED
  PENDING
  UNVERIFIED
  EXPIRED
  REJECTED
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  JOB_ALERTS
  PROFILE_SHARING
  DATA_RETENTION
  ANALYTICS
}

// Core User Account
model User {
  id              String             @id @default(uuid())
  phoneNumber     String             @unique // E.164 format: +250780000000
  whatsappId      String?            @unique
  fullName        String?
  email           String?
  preferredLang   LanguagePreference @default(KINYARWANDA)
  role            UserRole           @default(CANDIDATE)
  isActive        Boolean            @default(true)
  isBlocked       Boolean            @default(false)
  selectedServiceCode String?        // last WhatsApp menu choice
  serviceSelectedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  preferences     UserPreference?
  consents        Consent[]
  conversations   Conversation[]
  jobAlerts       JobAlert[]
  applications    Application[]
  workerProfile   WorkerProfile?
  employerProfile EmployerProfile?
  mediaAssets     MediaAsset[]
  codingProjects  CodingProject[]
  studySessions   StudySession[]
  usageRecords    UsageRecord[]
  auditLogs       AuditLog[]
  entitlements    Entitlement[]
  trialGrants     TrialGrant[]
  paymentOrders   PaymentOrder[]
  paymentProofs   PaymentProof[]
  examAttempts    ExamAttempt[]
  lessonProgress  LessonProgress[]

  @@index([phoneNumber])
  @@index([preferredLang])
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursStart String?  // e.g. "21:00"
  quietHoursEnd   String?  // e.g. "07:00"
  notifyViaSms    Boolean  @default(false)
  notifyViaWa     Boolean  @default(true)
  autoCvSharing   Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Consent {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConsentType
  granted     Boolean     @default(true)
  ipAddress   String?
  userAgent   String?
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?

  @@unique([userId, type])
  @@index([userId])
}

// WhatsApp Conversations & Messages
model Conversation {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastAgent    AgentType     @default(ROUTER)
  activeServiceCode String?  // service the conversation is currently routed to
  menuSentAt   DateTime?     // when the WhatsApp service menu was last offered
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages     Message[]
  memories     ConversationMemory[]
  agentRuns    AgentRun[]

  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id             String             @id @default(uuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?            @unique
  role           MessageRole
  type           MessageContentType @default(TEXT)
  content        String             @db.Text
  mediaUrl       String?
  tokensUsed     Int?               @default(0)
  timestamp      DateTime           @default(now())

  @@index([conversationId])
  @@index([timestamp])
}

model ConversationMemory {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  key            String       // e.g. "target_job_role", "education_level", "district"
  value          String       @db.Text
  confidence     Float        @default(1.0)
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, key])
}

// Jobs & Sources
model JobSource {
  id             String             @id @default(uuid())
  name           String             // e.g. "MIFOTRA E-Recruitment", "Job in Rwanda", "WeWorkRemotely"
  code           String             @unique // e.g. "MIFOTRA", "JOB_IN_RWANDA"
  baseUrl        String
  feedUrl        String?
  isPermitted    Boolean            @default(true)
  healthStatus   String             @default("HEALTHY") // HEALTHY, WARNING, DOWN
  lastCrawledAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  listings       JobListing[]
}

model JobListing {
  id                 String             @id @default(uuid())
  sourceId           String
  source             JobSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId         String?            // id on MIFOTRA or JobInRwanda
  title              String
  employer           String
  location           String             // e.g. "Kigali, Rwanda", "Remote", "Musanze"
  jobType            JobType            @default(FULL_TIME)
  description        String             @db.Text
  requirements       String?            @db.Text
  salaryRange        String?            // e.g. "RWF 450,000 - 600,000"
  sourceUrl          String
  deadline           DateTime?
  discoveredAt       DateTime           @default(now())
  lastVerifiedAt     DateTime           @default(now())
  verificationStatus VerificationStatus @default(VERIFIED)
  isExpired          Boolean            @default(false)

  applications       Application[]
  matches            JobMatch[]

  @@unique([sourceId, externalId])
  @@index([location])
  @@index([deadline])
  @@index([verificationStatus])
}

model JobAlert {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords   String             // e.g. "Software Engineer, Rwanda, Python"
  location   String?
  jobType    JobType?
  language   LanguagePreference @default(KINYARWANDA)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())

  @@index([userId])
}

model Application {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListingId String
  jobListing   JobListing  @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  cvUrl        String?
  coverLetter  String?     @db.Text
  status       TaskStatus  @default(PENDING)
  appliedAt    DateTime    @default(now())

  @@index([userId])
  @@index([jobListingId])
}

// Employment Marketplace
model WorkerProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String     // e.g. "Senior Full-Stack TypeScript Engineer"
  bio          String?    @db.Text
  skills       String[]   // e.g. ["React", "PostgreSQL", "Node.js", "Docker"]
  experienceYrs Int       @default(0)
  district     String     @default("Kigali") // Gasabo, Kicukiro, Nyarugenge, etc.
  isAvailable  Boolean    @default(true)
  hourlyRateRwf Int?
  cvUrl        String?
  rating       Float      @default(5.0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  matches      JobMatch[]
}

model EmployerProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  industry     String
  tinNumber    String?    // Rwanda Revenue Authority TIN
  isVerified   Boolean    @default(false)
  hqLocation   String     @default("Kigali")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  vacancies    Vacancy[]
}

model Vacancy {
  id           String          @id @default(uuid())
  employerId   String
  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title        String
  description  String          @db.Text
  requiredSkills String[]
  budgetRwf    Int?
  deadline     DateTime?
  status       TaskStatus      @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  matches      JobMatch[]
}

model JobMatch {
  id             String         @id @default(uuid())
  workerId       String
  worker         WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobListingId   String?
  jobListing     JobListing?    @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  vacancyId      String?
  vacancy        Vacancy?       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  score          Float          // 0.0 - 100.0
  explainability Json           // Breakdown: skillsMatch, locationMatch, experienceMatch
  isContacted    Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([workerId])
}

// Media & Photos
model MediaAsset {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalUrl  String
  processedUrl String?
  fileType     String
  fileSize     Int
  mimeType     String
  retentionDays Int        @default(30)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())

  tasks        ImageTask[]
}

model ImageTask {
  id           String      @id @default(uuid())
  mediaAssetId String
  mediaAsset   MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  operation    String      // "ENHANCE", "REMOVE_BG", "PASSPORT_CROP", "CV_PHOTO"
  status       TaskStatus  @default(PENDING)
  errorMessage String?
  createdAt    DateTime    @default(now())
  completedAt  DateTime?
}

// Coding Agent & Sandbox
model CodingProject {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  repoUrl      String?
  license      String       @default("MIT")
  framework    String       @default("TypeScript / Next.js")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tasks        CodingTask[]
}

model CodingTask {
  id           String        @id @default(uuid())
  projectId    String
  project      CodingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskType     String        // "SCAFFOLD", "DEBUG", "EXPLAIN", "SANDBOX_RUN"
  status       TaskStatus    @default(PENDING)
  inputPrompt  String        @db.Text
  outputResult String?       @db.Text
  sandboxExitCode Int?
  executionTimeMs Int?
  createdAt    DateTime      @default(now())
}

// Study Tutor
model StudySession {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String      // "Mathematics", "Science", "Programming", "English", "Ikinyarwanda"
  topic        String
  language     LanguagePreference @default(KINYARWANDA)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())

  quizzes      Quiz[]
}

model Quiz {
  id             String       @id @default(uuid())
  studySessionId String
  studySession   StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  question       String       @db.Text
  options        String[]
  correctIndex   Int
  explanation    String       @db.Text
  userAnswer     Int?
  isCorrect      Boolean?
  createdAt      DateTime     @default(now())
}

// AI Agent Orchestration, Tool Calls & Audits
model AgentRun {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentType      AgentType
  intentDetected String
  modelUsed      String       // "gemini-2.5-flash", "mock-agent"
  tokensInput    Int          @default(0)
  tokensOutput   Int          @default(0)
  latencyMs      Int          @default(0)
  status         TaskStatus   @default(COMPLETED)
  errorMessage   String?
  createdAt      DateTime     @default(now())

  toolCalls      ToolCall[]

  @@index([agentType])
  @@index([createdAt])
}

model ToolCall {
  id          String     @id @default(uuid())
  agentRunId  String
  agentRun    AgentRun   @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolName    String     // "search_mifotra_jobs", "generate_bilingual_cv", "run_sandbox_code", etc.
  arguments   Json
  result      Json
  latencyMs   Int        @default(0)
  createdAt   DateTime   @default(now())
}

// Webhook & Reliability
model WebhookEvent {
  id          String     @id @default(uuid())
  eventId     String     @unique // Meta message id or event hash
  eventType   String     // "messages", "message_deliveries", "message_reads"
  senderWaId  String
  rawPayload  Json
  isProcessed Boolean    @default(false)
  receivedAt  DateTime   @default(now())
  processedAt DateTime?

  @@index([senderWaId])
  @@index([receivedAt])
}

model ScheduledTask {
  id          String     @id @default(uuid())
  taskName    String     // "CRAWL_MIFOTRA", "SEND_JOB_ALERTS", "CLEANUP_EXPIRED_MEDIA"
  schedule    String     // cron or interval e.g. "0 */4 * * *"
  status      TaskStatus @default(PENDING)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
}

// Admin & Security
model AdminUser {
  id          String     @id @default(uuid())
  email       String     @unique
  passwordHash String
  name        String
  role        String     @default("SUPERADMIN") // SUPERADMIN, MODERATOR, AUDITOR
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())

  auditLogs   AuditLog[]
}

model AuditLog {
  id          String     @id @default(uuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String     // "VERIFY_JOB", "BAN_USER", "EXPORT_USER_DATA", "DELETE_USER"
  details     Json?
  ipAddress   String?
  timestamp   DateTime   @default(now())

  @@index([action])
  @@index([timestamp])
}

model UsageRecord {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  service     String     // "GEMINI_API", "WHATSAPP_CLOUD", "SANDBOX_COMPUTE"
  units       Int        // tokens, messages, seconds
  costUsd     Float      @default(0.0)
  timestamp   DateTime   @default(now())

  @@index([service])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// Commercial layer: services, entitlements, trials, payments
// ---------------------------------------------------------------------------

enum Currency {
  RWF
  USD
  EUR
}

enum BillingPeriod {
  PER_USE
  DAILY
  WEEKLY
  MONTHLY
}

enum EntitlementStatus {
  NONE
  TRIAL
  ACTIVE
  EXPIRED
}

enum PaymentOrderStatus {
  AWAITING_PROOF
  PROOF_UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum PaymentVerificationSource {
  MANUAL_ADMIN
  PAYMENT_PROVIDER_API
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

enum ProofReviewStatus {
  UNREVIEWED
  ACCEPTED
  FLAGGED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  NEEDS_REVIEW
  ARCHIVED
}

enum RoadSignCategory {
  WARNING
  PROHIBITORY
  MANDATORY
  DANGER
  INFORMATION
  SERVICE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamKind {
  PRACTICE
  MOCK_EXAM
  LEARN
}

enum QuestionSource {
  CURATED_PACK
  AI_GENERATED
  ADMIN_AUTHORED
}

enum GenerationRunKind {
  PRACTICE
  MOCK_EXAM
  LEARN
  ADMIN_BATCH
}

enum AuditActorRole {
  ADMIN
  SYSTEM
  USER
}

model ServiceDefinition {
  id                  String        @id @default(uuid())
  code                String        @unique
  nameEn              String
  nameRw              String
  descriptionEn       String
  descriptionRw       String
  agentType           AgentType
  isEnabled           Boolean       @default(true)
  showInWhatsAppMenu  Boolean       @default(true)
  isFree              Boolean       @default(true)
  // Charging stays off until an administrator confirms a price.
  chargeEnabled       Boolean       @default(false)
  price               Float         @default(0.0)
  currency            Currency      @default(RWF)
  billingPeriod       BillingPeriod @default(MONTHLY)
  trialHours          Int           @default(24)
  trialUsageLimit     Int           @default(0)
  paidUsageLimit      Int           @default(0)
  sortOrder           Int           @default(100)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  entitlements        Entitlement[]
  paymentOrders       PaymentOrder[]

  @@index([isEnabled, showInWhatsAppMenu])
}

model Entitlement {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceCode    String
  service        ServiceDefinition @relation(fields: [serviceCode], references: [code], onDelete: Restrict)
  status         EntitlementStatus @default(NONE)
  trialStartsAt  DateTime?
  trialExpiresAt DateTime?
  paidUntil      DateTime?
  usageCount     Int               @default(0)
  usageLimit     Int?
  lastUsedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, serviceCode])
  @@index([serviceCode, status])
}

// Append-only: the existence of a row is what blocks a second free trial.
model TrialGrant {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceCode String
  identityKey String          // normalised WhatsApp id / phone, catches same-person relinks
  grantedAt   DateTime
  expiresAt   DateTime

  @@index([userId, serviceCode])
  @@index([identityKey, serviceCode])
}

model PaymentOrder {
  id                    String                   @id @default(uuid())
  reference             String                   @unique
  userId                String
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceCode           String
  service               ServiceDefinition        @relation(fields: [serviceCode], references: [code], onDelete: Restrict)
  userPhone             String
  amount                Float
  currency              Currency                 @default(RWF)
  billingPeriod         BillingPeriod            @default(MONTHLY)
  payeeName             String
  payeeMomoCode         String
  status                PaymentOrderStatus       @default(AWAITING_PROOF)
  idempotencyKey        String?                  @unique
  riskBand              RiskBand?
  verificationSource    PaymentVerificationSource?
  verifiedBy            String?
  verifiedAt            DateTime?
  providerTransactionId String?
  rejectionReason       String?
  grantedEntitlementUntil DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  proofs                PaymentProof[]

  @@index([userId, serviceCode])
  @@index([status])
}

model PaymentProof {
  id                String         @id @default(uuid())
  orderId           String
  order             PaymentOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference         String
  uploadedBy        String
  storageKey        String         @unique // opaque; bytes live outside the web root
  fileName          String
  mimeType          String
  sizeBytes         Int
  sha256            String         // duplicate-screenshot detection
  width             Int?
  height            Int?
  duplicateProofIds String[]
  signals           Json           // forensic findings with severity + weight
  riskScore         Int            @default(0)
  riskBand          RiskBand       @default(LOW)
  ocr               Json           // text extraction + reference/amount/payee match results
  reviewStatus      ProofReviewStatus @default(UNREVIEWED)
  createdAt         DateTime       @default(now())

  @@index([sha256])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Road Safety Academy
// ---------------------------------------------------------------------------

model RoadSafetyModule {
  id         String        @id @default(uuid())
  code       String        @unique
  titleEn    String
  titleRw    String
  summaryEn  String
  summaryRw  String
  sortOrder  Int           @default(0)
  status     PublishStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  lessons    RoadSafetyLesson[]
  questions  RoadSafetyQuestion[]
  exams      ExamTemplate[]
}

model RoadSafetyLesson {
  id              String        @id @default(uuid())
  moduleId        String
  module          RoadSafetyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titleEn         String
  titleRw         String
  bodyEn          String
  bodyRw          String
  keyPointsEn     String[]
  keyPointsRw     String[]
  citations       Json          // sources this lesson was verified against
  legalVerifiedAt DateTime?
  lastReviewedBy  String?
  status          PublishStatus @default(DRAFT)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  questions       RoadSafetyQuestion[]
  progress        LessonProgress[]

  @@index([moduleId, status])
}

model RoadSign {
  id               String           @id @default(uuid())
  code             String           @unique
  category         RoadSignCategory
  nameEn           String
  nameRw           String
  meaningEn        String
  meaningRw        String
  shape            String
  colourConvention String
  /// Durable key of a photographed official sign uploaded by an administrator. A
  /// sign-identification question stays unpublished while this is null: an AI-drawn
  /// approximation of a legal sign would teach the wrong meaning.
  imageKey         String?
  citations        Json
  legalVerifiedAt  DateTime?
  status           PublishStatus    @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  questions        RoadSafetyQuestion[]

  @@index([category, status])
}

model RoadSafetyQuestion {
  id              String            @id @default(uuid())
  moduleId        String
  module          RoadSafetyModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonId        String?
  lesson          RoadSafetyLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  signId          String?
  sign            RoadSign?         @relation(fields: [signId], references: [id], onDelete: SetNull)
  questionEn      String
  questionRw      String
  optionsEn       String[]
  optionsRw       String[]
  correctIndex    Int
  /// Set only for a multi-answer paper; null means one correct option.
  correctIndexes  Int[]
  explanationEn   String
  explanationRw   String
  difficulty      QuestionDifficulty @default(MEDIUM)
  citations       Json
  legalVerifiedAt DateTime?
  status          PublishStatus     @default(DRAFT)
  /// Verified fact ids this item tests, so revision targeting has something to walk.
  factIds         String[]          @default([])
  source          QuestionSource    @default(CURATED_PACK)
  /// Provider, model, run id and token cost of the run that produced this row.
  generation      Json?
  /// Why the verification gate held the item back; cleared when a person approves it.
  reviewReasons   String[]          @default([])
  /// Learner and admin reports that the item is wrong, with how each was resolved.
  issueReports    Json              @default("[]")
  /// Normalised stem + options + key, used by the duplicate detector.
  fingerprint     String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([moduleId, status])
  @@index([fingerprint])
  @@index([status])
}

model ExamTemplate {
  id                String            @id @default(uuid())
  nameEn            String
  nameRw            String
  moduleId          String?
  module            RoadSafetyModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questionCount     Int               @default(10)
  passPercent       Int               @default(70)
  timeLimitMinutes  Int?
  /// Server-enforced examination behaviour: no answer key before submission.
  strictMode        Boolean           @default(false)
  /// A citation only when count, duration or pass mark comes from an authoritative
  /// source; null marks these as administrator-chosen simulation settings.
  officialBasis     Json?
  status            PublishStatus     @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  attempts          ExamAttempt[]

  @@index([status])
}

model ExamAttempt {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            ExamKind
  examTemplateId  String?
  examTemplate    ExamTemplate? @relation(fields: [examTemplateId], references: [id], onDelete: SetNull)
  moduleId        String?
  language        LanguagePreference
  questionIds     String[]
  answers         Json          // per-question correction + bilingual explanation
  /// Autosaved picks, index-aligned to questionIds; null at a position means unanswered.
  savedAnswers    Json              @default("[]")
  /// Seconds per item, index-aligned to questionIds, accumulated by the server.
  answerSeconds   Int[]             @default([])
  totalQuestions  Int
  correctCount    Int           @default(0)
  scorePercent    Int           @default(0)
  passPercent     Int           @default(0)
  passed          Boolean       @default(false)
  startedAt       DateTime
  submittedAt     DateTime?
  durationSeconds Int?
  /// Server-owned timer: the deadline is written at creation, never taken from a client clock.
  timeLimitSeconds Int?
  deadlineAt      DateTime?
  strict          Boolean       @default(false)
  /// False while a strict paper is unfinished, so the key cannot be read early.
  answersRevealed Boolean       @default(true)
  lastActivityAt  DateTime          @default(now())

  @@index([userId, kind])
  @@index([submittedAt])
}

/// One provider call for fresh questions, kept so cost and failure are auditable.
model QuestionGenerationRun {
  id            String             @id @default(uuid())
  startedAt     DateTime
  userId        String?
  kind          GenerationRunKind
  requested     Int
  factIds       String[]          @default([])
  provider      String?
  model         String?
  candidates    Int                @default(0)
  published     Int                @default(0)
  heldForReview Int                @default(0)
  tokensUsed    Int                @default(0)
  latencyMs     Int                @default(0)
  /// Provider chain trace, for the operator only.
  attempts      String[]          @default([])
  error         String?

  @@index([startedAt])
  @@index([userId])
}

/// Single-row academy configuration: what may be generated, at what limits, and which
/// sources are approved. Kept as one row because the whole object is read together.
model RoadSafetySettings {
  id        String   @id @default("ROAD_SAFETY")
  settings  Json
  updatedAt DateTime @updatedAt
}

model LessonProgress {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      RoadSafetyLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime

  @@unique([userId, lessonId])
}

// Structured before/after trail for commercial and curriculum changes.
model AuditEntry {
  id         String         @id @default(uuid())
  actor      String
  actorRole  AuditActorRole
  action     String
  targetType String
  targetId   String
  summary    String
  before     Json?
  after      Json?
  createdAt  DateTime       @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}
