# AI Studio runtime injected variables
# Gemini carries the traffic and answers first. OPENAI_API_KEY further down is the
# rescue; a server with only one of the two works, but has nobody to hand over to
# when that provider has a bad minute, and the config warns about it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
APP_URL="MY_APP_URL"

# Server Port & Environment
NODE_ENV="production"
PORT="3000"

# WhatsApp Business Cloud API Configuration
# Get from Meta for Developers (developers.facebook.com) > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID="109876543210987"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxx_replace_with_meta_system_user_token"
WHATSAPP_VERIFY_TOKEN="replace_with_a_random_verify_token_you_choose"
WHATSAPP_APP_SECRET="replace_with_meta_app_secret_for_sha256_signature_verification"
# Graph API version used for every request, including the read receipt and the
# "typing…" indicator that follows it. Defaults to v23.0. Set it to v22.0 or
# newer — anything older silently drops typing indicators. A malformed value
# falls back to the default rather than building a broken URL.
# WHATSAPP_GRAPH_VERSION="v23.0"

# Database Configuration (PostgreSQL with connection pooling)
DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/aguka_db?schema=public"

# Redis & Queue Configuration (BullMQ)
# With REDIS_URL set, jobs are stored and executed by BullMQ in Redis. Without it,
# the queue runs inside the web process and clears on restart.
# Use rediss:// (double s) for any hosted provider — they only accept TLS.
# Upstash: open the database, Settings, enable "TCP port (Redis protocol)", then use
# the proxy host it shows. The REST endpoint cannot run BullMQ. If the token contains
# "/", set the two UPSTASH fields below instead of embedding it in the URL.
REDIS_URL="rediss://default:your_upstash_tcp_token@your-proxy-host.upstash.io:6379"
# Local Redis / Memurai instead of a hosted one:
# REDIS_URL="redis://:strong_redis_password@localhost:6379"
# Alternative to REDIS_URL for Upstash TCP:
# UPSTASH_REDIS_TCP_HOST="your-proxy-host.upstash.io"
# UPSTASH_REDIS_TCP_PORT="6379"
# UPSTASH_REDIS_TOKEN="your_upstash_tcp_token"
# UPSTASH_REDIS_USERNAME="default"
# Queue name, worker concurrency, and whether this web process also runs a worker.
# Serverless deployments (Vercel) must set QUEUE_INLINE_WORKER=false and run
# `npm run worker` on an always-on host. QUEUE_SKIP_VERSION_CHECK=true helps when the
# provider forbids the INFO command BullMQ uses to check the Redis version.
QUEUE_NAME="aguka-jobs"
QUEUE_CONCURRENCY="5"
QUEUE_INLINE_WORKER="true"
QUEUE_SKIP_VERSION_CHECK="false"

# S3 / Object Storage (Cloudflare R2, AWS S3, or MinIO)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="aguka-user-media"
S3_ACCESS_KEY_ID="replace_with_s3_key"
S3_SECRET_ACCESS_KEY="replace_with_s3_secret"

# Admin Authentication & Encryption Secret
# ADMIN_JWT_SECRET has no built-in fallback: admin login is disabled until you set it.
ADMIN_JWT_SECRET="replace_with_random_secret_min_32_chars"
ADMIN_DEFAULT_EMAIL="replace_with_admin_email"
ADMIN_DEFAULT_PASSWORD="replace_with_strong_admin_password"

# Platform Rate Limits & Budgets
MAX_MESSAGES_PER_MINUTE_PER_USER="20"
MAX_DAILY_AI_TOKENS_PER_USER="50000"

# Durable Local Store
# Operational records that must survive a restart — users, service selections,
# entitlements, trial grants, payment orders, uploaded proofs, road safety content
# and the audit trail — are written to an atomic JSON snapshot plus a private
# proofs directory under this path. Give it a persistent volume in production.
# The directory is git-ignored; never commit real user records or receipts.
AGUKA_DATA_DIR=".aguka-data"

# Mobile Money Payee Details (shown in the payment instructions a user receives)
MOMO_PAYEE_NAME="replace_with_payee_name"
MOMO_PAYEE_CODE="replace_with_payee_code"

# Provider Reconciliation (optional)
# Point these at the operator's own transaction-status endpoint. The request and
# response field names in lib/payments/adapters.ts are a neutral contract and must
# be aligned with that API before use. Without them no payment is ever verified by
# code: every order stays in the administrator review queue.
MOMO_VERIFY_API_URL=""
MOMO_VERIFY_API_TOKEN=""

# Shared secret issued by the payment provider for POST /api/payments/webhook.
# Unset, that endpoint answers 503 and accepts nothing.
PAYMENT_WEBHOOK_SECRET=""

# Let a correctly signed provider webhook unlock a service on its own.
# Leave false until reconciliation is configured; the webhook can then confirm a
# payment without an administrator.
PAYMENT_AUTO_VERIFY="false"

# OpenAI: receipt text reading AND the rescue text provider
# Proofs are hash- and metadata-checked without this; it only adds OCR text.
# One key does two jobs. Set it and OpenAI also joins the reply chain behind
# Gemini: a rate limit, timeout, blocked or empty Gemini answer is retried once,
# then the same question is put to OpenAI before anyone is told it failed.
# With only this key and no GEMINI_API_KEY, OpenAI answers first.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"
# Chat model used for replies. Defaults to gpt-4o.
OPENAI_TEXT_MODEL="gpt-4o"

# Research, category routing and memory (all on by default)
# Google Search grounding uses the GEMINI_API_KEY above — no second credential.
# A turn is looked up live only when the server decides it must be: the person
# asked for a search, the answer is a fact that changes (price, rate, deadline,
# weather), or Aguka holds nothing on the subject. Their own records and the Road
# Safety Academy are never answered from a web page. Google bills per search, so
# AI_WEB_SEARCH="false" turns lookups off while ordinary replies keep working.
AI_WEB_SEARCH="true"
# Set this only if OpenAI must answer searched turns: name a search-capable model
# (a gpt-4o web-search variant). Without it, a searched turn is handed to Gemini
# and OpenAI is skipped — a model that cannot browse must not return remembered
# text dressed up as a researched answer.
# OPENAI_SEARCH_MODEL=""
# Remember durable facts about a person after an answered turn ("district=Huye",
# "trade=plumbing"), stored per conversation and read back into later prompts.
# Secret-shaped values, phone/ID-length digit strings and over-long values are
# refused; four facts per turn, sixteen per person. Costs one small JSON call per
# substantive message. AI_MEMORY_EXTRACT="false" stops it entirely.
AI_MEMORY_EXTRACT="true"

# Image Studio (optional)
# Same OPENAI_API_KEY / GEMINI_API_KEY above are reused — nothing extra to create.
# With a key present, a WhatsApp user who asks for a passport photo (or sends a
# photo with a caption asking for it to be retouched) gets a real rendered JPEG
# delivered back on WhatsApp. Without one, that request is refused honestly and
# nothing is charged to the user's usage.
# OPENAI_IMAGE_MODEL defaults to gpt-image-1; GEMINI_IMAGE_MODEL defaults to
# gemini-2.5-flash-image. OpenAI is preferred when both keys exist.
OPENAI_IMAGE_MODEL="gpt-image-1"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# Rendered passport width in pixels; height follows the 35:45 ratio automatically.
# PASSPORT_PHOTO_WIDTH="700"
# How many days a rendered photo is kept before the retention sweep deletes the
# file. Shorten this for DPPA purposes-limitation; 30 days is the default.
# IMAGE_RETENTION_DAYS="30"

# Job board discovery (optional)
# The Jobs screen reads real boards: Job in Rwanda (server-rendered cards) and the
# remote tech feeds. Nothing is invented to fill an empty board, and a listing with
# no link back to its posting is refused by the zero-hallucination gate.

# Point a board at the RSS/Atom address it publishes, using its own code, e.g.
# JOB_FEED_URL_MIFOTRA. MIFOTRA e-recruitment serves a JavaScript shell and has no
# feed, sitemap or documented listings API, so without an override the crawl reports
# that reason instead of reverse-engineering the portal. The value must be a feed:
# pointing it at a page reports "not an RSS or Atom document" rather than passing as
# an empty board.
# JOB_FEED_URL_MIFOTRA=""

# The queue worker sweeps every N minutes as well as on start. 0 turns the schedule
# off and leaves only the Crawl now button on the Jobs screen. Serverless hosts
# cannot run the worker, so set this to 0 there and run the crawl elsewhere.
# JOB_CRAWL_INTERVAL_MINUTES="60"
# How long one board may take before the crawl calls it failed.
# JOB_CRAWL_TIMEOUT_MS="15000"
# Most listings stored from a single board per crawl, newest-first.
# JOB_CRAWL_MAX_LISTINGS="60"
